<?xml version="1.0" encoding="utf-8"?>
<!--
    백업·기기 이전 제외 (LEAD_REVIEW D6)
    자격 증명은 이 기기의 Keystore 키로 암호화되어 다른 기기에서는 복호화할 수 없다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
